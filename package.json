{
  "name": "bookshelf",
  "version": "2.18.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:without-check": "SKIP_VITE_CHECKER=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "concurrently --group 'pnpm run lint' 'pnpm run format:check' 'pnpm run typecheck'",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write '**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,css,html,yaml,yml}'",
    "format:check": "oxfmt --check '**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,css,html,yaml,yml}'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e-mock-api/tsconfig.json && tsc --noEmit -p e2e-demo-mode/tsconfig.json && tsc --noEmit -p e2e-integration/tsconfig.json",
    "generate": "bash scripts/fetch-schema.sh && pnpm run generate:without-fetch",
    "generate:without-fetch": "graphql-codegen --config codegen.yml && msw init && tsr generate",
    "generate:msw": "msw init",
    "test:e2e:mock-api": "playwright test",
    "test:e2e:demo-mode": "playwright test --config=playwright.demo.config.ts",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.ts",
    "integration:up": "bash scripts/integration-up.sh",
    "integration:down": "bash scripts/integration-down.sh"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.27.0",
    "@mantine/core": "9.6.2",
    "@mantine/form": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@mantine/notifications": "9.6.2",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-table": "9.2.4",
    "dayjs": "1.11.23",
    "graphql": "17.0.2",
    "graphql-request": "7.4.0",
    "mantine-form-zod-resolver": "1.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.2",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-graphql-request": "7.1.0",
    "@graphql-codegen/typescript-operations": "6.1.7",
    "@graphql-tools/schema": "10.1.1",
    "@playwright/test": "1.63.0",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-cli": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "graphql-tag": "2.12.7",
    "jose": "6.2.12",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.27.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
